package cjh.web

import stdx.encoding.base64.*

/**
 * 自托管的前端第三方依赖（离线/内网可用，避免首屏依赖 CDN）。
 *
 * 版本固定：marked 12.0.2 (MIT)、DOMPurify 3.4.17 (Apache-2.0/MPL-2.0)、
 * highlight.js 11.9.0 + github-dark 主题 (BSD-3-Clause)。
 * 以 base64 嵌入：vendor 源码含 `"""`/反斜杠/`${}`，直接写字符串字面量会
 * 触发 raw string 终止或转义/插值；base64 字符集无这些歧义。
 */
public class WebVendorAssets {
    private static let markedJsB64: String =
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        ""

    public static func markedJs(): String { return decodeB64(markedJsB64) }

    private static let purifyJsB64: String =
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        ""

    public static func purifyJs(): String { return decodeB64(purifyJsB64) }

    private static let highlightJsB64: String =
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        ""

    public static func highlightJs(): String { return decodeB64(highlightJsB64) }

    private static let githubDarkCssB64: String =
        ""

    public static func githubDarkCss(): String { return decodeB64(githubDarkCssB64) }

    private static func decodeB64(data: String): String {
        match (fromBase64String(data)) {
            case Some(bytes) => return String.fromUtf8(bytes)
            case None => return ""
        }
    }
}
